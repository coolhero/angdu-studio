# Cherry Studio Environment Variables
# Generated by reverse-spec from /Users/coolhero/Study/oss/cherry-studio
# Date: 2026-03-02

# ── Shared (used by multiple Features) ──

# Node.js memory limit for Electron main process
NODE_OPTIONS=--max-old-space-size=8000

# ── F001-platform ──

# Main process console log level (debug|info|warn|error)
CSLOGGER_MAIN_LEVEL=info
# Renderer process console log level (debug|info|warn|error)
CSLOGGER_RENDERER_LEVEL=info
# Comma-separated module names to filter main process logs
#CSLOGGER_MAIN_SHOW_MODULES=
# Comma-separated module names to filter renderer logs
#CSLOGGER_RENDERER_SHOW_MODULES=

# App bundle ID override (build-time, Vite)
#VITE_MAIN_BUNDLE_ID=com.kangfenmao.CherryStudio

# ── F002-ai-foundation ──

# CherryAI client secret (build-time injection via Vite)
#MAIN_VITE_CHERRYAI_CLIENT_SECRET=your-cherryai-client-secret

# Integrated model config (JSON, build-time injection via Vite)
#VITE_RENDERER_INTEGRATED_MODEL=

# ── F003-chat ──

# DiDi MCP server API key
#DIDI_API_KEY=your-didi-api-key

# Auto-approve Claude Code agent tool calls (set to "1" to enable)
#CHERRY_AUTO_ALLOW_TOOLS=

# ── F006-creative ──

# PPIO OAuth app secret (build-time injection via Vite)
#RENDERER_VITE_PPIO_APP_SECRET=your-ppio-app-secret

# ── F007-extensions ──

# AihubMix OAuth AES decryption secret (build-time injection via Vite)
#RENDERER_VITE_AIHUBMIX_SECRET=your-aihubmix-secret

# Git Bash path override for Windows (for Claude Code agent)
#CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# ── Scripts Only (not needed at runtime) ──

# API key for i18n auto-translation scripts
#API_KEY=sk-xxx
# Base URL for translation API
#BASE_URL=https://api.siliconflow.cn/v1/
# Model for translation
#MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Bundle visualizer (set to "true" to enable)
#VISUALIZER_MAIN=
#VISUALIZER_RENDERER=
