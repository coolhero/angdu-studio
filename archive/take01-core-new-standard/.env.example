# ── Cherry Studio Environment Variables ──
# Generated from reverse-spec analysis of /Users/coolhero/Study/oss/cherry-studio
# 2026-03-02

# ── Shared (used by multiple Features) ──

# Node.js memory limit for builds
NODE_OPTIONS=--max-old-space-size=8000

# ── F001-app-core ──

# Electron bundle ID
# VITE_MAIN_BUNDLE_ID=com.kangfenmao.CherryStudio

# ── F002-settings-theme ──

# Logging configuration
# CSLOGGER_MAIN_LEVEL=info
# CSLOGGER_RENDERER_LEVEL=info
# CSLOGGER_MAIN_SHOW_MODULES=
# CSLOGGER_RENDERER_SHOW_MODULES=

# ── F003-provider-management ──

# Default AI provider configuration (for development/testing)
API_KEY=sk-xxx
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o

# CherryAI client secret (build-time, CI only)
# MAIN_VITE_CHERRYAI_CLIENT_SECRET=

# AihubMix OAuth secret (build-time)
# RENDERER_VITE_AIHUBMIX_SECRET=

# PPIO OAuth secret (build-time)
# RENDERER_VITE_PPIO_APP_SECRET=

# Integrated model config for local-AI mode (build-time, JSON)
# VITE_RENDERER_INTEGRATED_MODEL=

# ── F007-mcp ──

# DiDi MCP server API key
# DIDI_API_KEY=

# ── F012-api-server-agents ──

# Auto-approve Claude Code tools (set to '1' to enable, development only)
# CHERRY_AUTO_ALLOW_TOOLS=

# ── Build/CI Only (not needed for development) ──

# Windows code signing
# CHERRY_CERT_PATH=
# CHERRY_CERT_KEY=
# CHERRY_CERT_CSP=
# WIN_SIGN=

# macOS notarization
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Feishu/Lark webhook notification
# FEISHU_WEBHOOK_URL=
# FEISHU_WEBHOOK_SECRET=

# i18n translation automation
# TRANSLATION_API_KEY=
# TRANSLATION_BASE_URL=
# TRANSLATION_MODEL=
# TRANSLATION_BASE_LOCALE=en-us

# MinerU API key (for knowledge base PDF preprocessing, CI)
# MAIN_VITE_MINERU_API_KEY=
