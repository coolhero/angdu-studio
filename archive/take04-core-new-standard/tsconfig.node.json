{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out",
    "lib": ["ESNext"],
    "types": ["node"],
    "paths": {
      "@main/*": ["./src/main/*"],
      "@shared/*": ["./packages/shared/*"],
      "@aiCore/*": ["./packages/aiCore/src/*"],
      "@ai-sdk-provider/*": ["./packages/ai-sdk-provider/src/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "packages/shared/**/*.ts",
    "packages/aiCore/src/**/*.ts",
    "packages/ai-sdk-provider/src/**/*.ts",
    "electron.vite.config.ts"
  ]
}
