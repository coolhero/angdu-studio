# Cherry Studio — Environment Variables
# Generated: 2026-03-04 by /reverse-spec
# Copy this file to .env and fill in your values.

# ── Shared (used by multiple Features) ──

# Node.js runtime options
NODE_OPTIONS=--max-old-space-size=8000

# ── F001-core-platform ──

# Electron bundle identifier
VITE_MAIN_BUNDLE_ID=com.kangfenmao.CherryStudio

# Logging levels (debug | info | warn | error)
CSLOGGER_MAIN_LEVEL=info
CSLOGGER_RENDERER_LEVEL=info
CSLOGGER_AICORE_LEVEL=info

# ── F002-provider-management ──

# Default provider credentials (for development/testing)
API_KEY=your-api-key-here
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o

# ── F004-knowledge-base ──

# MinerU PDF preprocessing API key (optional)
MAIN_VITE_MINERU_API_KEY=your-mineru-api-key-here

# ── F010-auxiliary-features ──

# PPIO cloud service secret (optional, for image generation)
RENDERER_VITE_PPIO_APP_SECRET=your-ppio-secret-here

# AIHubMix service secret (optional)
RENDERER_VITE_AIHUBMIX_SECRET=your-aihubmix-secret-here

# ── F012-agent-framework ──

# Auto-allow all tool calls without permission prompt (development only)
# CHERRY_AUTO_ALLOW_TOOLS=true

# Git Bash path for Windows (agent framework shell commands)
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
