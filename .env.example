# Angdu Studio — Environment Variables
# Generated by /reverse-spec Phase 4 — 2026-03-08
# Copy to .env and fill in required values

# ── Shared (used by multiple Features) ──────────────────

# Node.js runtime options
NODE_OPTIONS=--max-old-space-size=8000

# ── F001-app-core ──────────────────────────────────────

# Logging levels: debug, info, warn, error
CSLOGGER_MAIN_LEVEL=info
CSLOGGER_RENDERER_LEVEL=info
# Optional: filter logs to specific modules (comma-separated)
# CSLOGGER_MAIN_SHOW_MODULES=MCPService,KnowledgeService
# CSLOGGER_RENDERER_SHOW_MODULES=

# ── F002-ai-provider ──────────────────────────────────

# Provider API keys (configured in-app via Settings > Model Provider)
# These are NOT required in .env — they are stored in the app's settings UI
# API_KEY=your-api-key
# BASE_URL=your-api-base-url
# MODEL=your-model-name

# ── F009-agents ────────────────────────────────────────

# Auto-approve tool permissions (development only)
# CHERRY_AUTO_ALLOW_TOOLS=1
