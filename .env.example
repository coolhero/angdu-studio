# Angdu Studio Environment Configuration
# Copy this file to .env and fill in values

# ── Shared (used by multiple Features) ──
NODE_ENV=development

# ── F001-app-core ──
ANGDU_LOGGER_MAIN_LEVEL=info
ANGDU_LOGGER_RENDERER_LEVEL=info
ANGDU_LOGGER_MAIN_SHOW_MODULES=
ANGDU_LOGGER_RENDERER_SHOW_MODULES=

# Proxy (optional)
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port
# SOCKS_PROXY=socks5://proxy:port

# ── F002-ai-provider ──
API_KEY=your-api-key-here
BASE_URL=https://api.openai.com/v1/
MODEL=gpt-4

# ── F005-auth ──
# macOS notarization (build only)
# APPLE_ID=your-apple-id
# APPLE_APP_SPECIFIC_PASSWORD=your-password
# APPLE_TEAM_ID=your-team-id

# Windows code signing (build only)
# ANGDU_CERT_PATH=/path/to/cert
# ANGDU_CERT_KEY=container-name
# ANGDU_CERT_CSP=csp-provider

# ── F010-agent ──
# ANGDU_AUTO_ALLOW_TOOLS=0

# ── F012-extensions ──
# DIDI_API_KEY=your-didi-api-key

# ── i18n scripts ──
# TRANSLATION_API_KEY=your-translation-api-key
# TRANSLATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
# TRANSLATION_MODEL=qwen-plus-latest
