# Angdu Studio — Environment Variables
# Copy to .env and fill in your values

# ──────────────────────────────────────
# Node.js Runtime
# ──────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=8000

# ──────────────────────────────────────
# AI Provider (F004: ai-engine)
# Default provider for development/testing
# ──────────────────────────────────────
API_KEY="sk-xxx"
BASE_URL="https://api.openai.com/v1/"
MODEL="gpt-4o"

# ──────────────────────────────────────
# Logging (F001: app-shell)
# Levels: error, warn, info, debug, trace
# ──────────────────────────────────────
ANGDU_LOGGER_MAIN_LEVEL=info
ANGDU_LOGGER_RENDERER_LEVEL=info
# ANGDU_LOGGER_MAIN_SHOW_MODULES=
# ANGDU_LOGGER_RENDERER_SHOW_MODULES=

# ──────────────────────────────────────
# MCP Servers (F008: mcp)
# ──────────────────────────────────────
# DIDI_API_KEY=

# ──────────────────────────────────────
# Build / CI
# ──────────────────────────────────────
# VISUALIZER_RENDERER=true
# VISUALIZER_MAIN=true
