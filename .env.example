# ── Shared (used by multiple Features) ──
NODE_OPTIONS=--max-old-space-size=8000
NODE_ENV=development

# ── F001-shell ──
# PORTABLE_EXECUTABLE_DIR=    # Windows portable mode
# PORTABLE_EXECUTABLE_FILE=   # Windows portable exe path

# ── F002-i18n-theme ──
# (no env vars — language/theme stored in app config)

# ── F003-providers ──
# API_KEY=sk-xxx              # Default LLM provider API key (secret)
# BASE_URL=https://api.example.com/v1/  # Default provider base URL

# ── F004-settings ──
CSLOGGER_MAIN_LEVEL=info
CSLOGGER_RENDERER_LEVEL=info
# CSLOGGER_MAIN_SHOW_MODULES=
# CSLOGGER_RENDERER_SHOW_MODULES=

# ── F009-agents ──
# CLAUDE_CODE_GIT_BASH_PATH=  # Git bash path for Windows agent sessions

# ── Build ──
VITE_MAIN_BUNDLE_ID=com.kangfenmao.AngduStudio
