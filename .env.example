# ── Angdu Studio Environment Variables ──
# Generated by /reverse-spec from Cherry Studio analysis

# ── Shared (used by multiple Features) ──
NODE_OPTIONS=--max-old-space-size=8000
NODE_ENV=development

# ── F004-model-provider ──
# REQUIRES: your-api-key-here
API_KEY=
BASE_URL=https://api.openai.com/v1/
MODEL=gpt-4o

# ── F001-app-shell (Logging) ──
CSLOGGER_MAIN_LEVEL=info
CSLOGGER_RENDERER_LEVEL=info
#CSLOGGER_MAIN_SHOW_MODULES=
#CSLOGGER_RENDERER_SHOW_MODULES=

# ── F007-mcp-tools ──
# REQUIRES: your-didi-api-key-here (optional, for DiDi MCP)
#DIDI_API_KEY=

# ── F001-app-shell (Feature Flags) ──
# Set to "1" to enable auto-approval of Claude Code tools
#CHERRY_AUTO_ALLOW_TOOLS=
