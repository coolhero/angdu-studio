# =============================================================================
# Angdu Studio — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values as needed.
# Lines starting with # are comments. Uncomment to activate.

# -----------------------------------------------------------------------------
# Node.js Runtime
# -----------------------------------------------------------------------------
NODE_OPTIONS=--max-old-space-size=8000

# -----------------------------------------------------------------------------
# Logger Configuration (Feature: Settings / App Core)
# -----------------------------------------------------------------------------
# Log level for main process: trace | debug | info | warn | error | fatal
ASLOGGER_MAIN_LEVEL=info
# Log level for renderer process
ASLOGGER_RENDERER_LEVEL=info
# Comma-separated list of modules to show in logs (empty = show all)
#ASLOGGER_MAIN_SHOW_MODULES=
#ASLOGGER_RENDERER_SHOW_MODULES=

# -----------------------------------------------------------------------------
# i18n Translation Scripts (Development Only)
# -----------------------------------------------------------------------------
# Used by scripts/update-i18n.ts and scripts/auto-translate-i18n.ts
API_KEY="sk-xxx"
BASE_URL="https://api.siliconflow.cn/v1/"
MODEL="Qwen/Qwen3-235B-A22B-Instruct-2507"

# Translation script specific
#TRANSLATION_API_KEY=
#TRANSLATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
#TRANSLATION_MODEL=qwen-plus-latest
#TRANSLATION_MAX_CONCURRENT_REQUESTS=3
#TRANSLATION_DELAY_MS=500
#TRANSLATION_BASE_LOCALE=en-us

# i18n check base locale
#BASE_LOCALE=zh-cn

# -----------------------------------------------------------------------------
# macOS Code Signing & Notarization (CI/CD Only)
# -----------------------------------------------------------------------------
#APPLE_ID=
#APPLE_APP_SPECIFIC_PASSWORD=
#APPLE_TEAM_ID=

# -----------------------------------------------------------------------------
# Windows Code Signing (CI/CD Only)
# -----------------------------------------------------------------------------
#WIN_SIGN=false
#ANGDU_CERT_PATH=
#ANGDU_CERT_KEY=
#ANGDU_CERT_CSP=

# -----------------------------------------------------------------------------
# Release & CI (CI/CD Only)
# -----------------------------------------------------------------------------
#RELEASE_TAG=
#GITHUB_REF_NAME=
#TAG_NAME=

# -----------------------------------------------------------------------------
# Feishu/Lark Notifications (CI/CD Only)
# -----------------------------------------------------------------------------
#FEISHU_WEBHOOK_URL=
#FEISHU_WEBHOOK_SECRET=
