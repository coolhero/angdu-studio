# =============================================================================
# Angdu Studio — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- General ---
NODE_ENV=development
# NODE_OPTIONS=--max-old-space-size=8000

# --- Logging (F001 Electron Shell) ---
# Log levels: error, warn, info, debug, trace
ANGDU_LOGGER_MAIN_LEVEL=info
ANGDU_LOGGER_RENDERER_LEVEL=info
# Comma-separated module names to filter logs
# ANGDU_LOGGER_MAIN_SHOW_MODULES=
# ANGDU_LOGGER_RENDERER_SHOW_MODULES=

# --- Provider Defaults (F004 Provider Management) ---
# These are development/testing defaults only.
# In production, users configure providers via the Settings UI.
# API_KEY="sk-xxx"
# BASE_URL="https://api.openai.com/v1/"
# MODEL="gpt-4o"

# --- Auto-Update (F001 Electron Shell) ---
# Electron updater feed URL (optional, defaults to GitHub releases)
# ANGDU_UPDATE_FEED_URL=

# --- Proxy (F007 Settings System) ---
# System proxy is used by default. Override here for development.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# --- Platform-Specific (F001 Electron Shell) ---
# Windows portable mode (set automatically)
# PORTABLE_EXECUTABLE_DIR=
# PORTABLE_EXECUTABLE_FILE=
# Linux AppImage (set automatically)
# APPIMAGE=
